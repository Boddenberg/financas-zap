# Projeto Supabase do Finanças. A chave anon é pública; nunca use service role.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Chave exclusiva gerada em Casa > Ajustes > WhatsApp. Ela libera somente as
# duas funções da caixa de saída (ler e confirmar entrega) e o pulso do backend.
FINANCAS_BRIDGE_TOKEN=""

# API do Finanças, com o prefixo. A ponte bate um pulso aqui antes de cada
# leitura: é ele que dá hora ao resumo diário, aos panoramas e ao fechamento de
# um bloco de registros — o backend não tem agendador próprio.
FINANCAS_API_URL="https://seu-backend.up.railway.app/api/v1"

# Destino padrão: números separados por vírgula. Aceita DDD + número e acrescenta
# o código 55, ou aceita o formato internacional completo.
WHATSAPP_RECIPIENTS="5511999999999,5511888888888"
DEFAULT_COUNTRY_CODE="55"

# Opcional. Quando preenchido, substitui os números acima pelo grupo.
# Descubra o ID com: npm run list:groups
WHATSAPP_GROUP_ID=""

POLL_INTERVAL_SECONDS="15"
APP_TIMEZONE="America/Sao_Paulo"
STATE_PATH=".runtime/casa-notifications.json"

TEST_MESSAGE="Teste do Finanças Zap"
HEADLESS="true"
