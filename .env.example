# Texto enviado no teste.
TEST_MESSAGE=Oi

# true: envia para a própria conta conectada.
# false: envia para TARGET_PHONE.
SEND_TO_SELF=true

# Obrigatório apenas quando SEND_TO_SELF=false.
# Use código do país + DDD + número, sem o zero da operadora.
# Exemplo fictício: 5511999999999
TARGET_PHONE=

# true executa o Chromium sem abrir uma janela visível.
HEADLESS=true
