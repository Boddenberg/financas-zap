# Projeto Supabase do Finanças. A chave anon é pública; nunca use service role.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Chave exclusiva gerada em Casa > Ajustes > WhatsApp.
# Ela libera somente a função que devolve id, mensagem e criada_em.
FINANCAS_BRIDGE_TOKEN=""

# Destino padrão: números separados por vírgula. Aceita DDD + número e acrescenta
# o código 55, ou aceita o formato internacional completo.
WHATSAPP_RECIPIENTS="5511999999999,5511888888888"
DEFAULT_COUNTRY_CODE="55"

# Opcional. Quando preenchido, substitui os números acima pelo grupo.
# Descubra o ID com: npm run list:groups
WHATSAPP_GROUP_ID=""

POLL_INTERVAL_SECONDS="15"
APP_TIMEZONE="America/Sao_Paulo"
STATE_PATH=".runtime/casa-notifications.json"

TEST_MESSAGE="Teste do Finanças Zap"
HEADLESS="true"
