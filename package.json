{
  "name": "financas-zap",
  "version": "1.0.0",
  "private": true,
  "description": "Entregador local da caixa de saída do Supabase para o WhatsApp.",
  "packageManager": "npm@11.6.2",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test:message": "tsx src/index.ts --test-message",
    "list:groups": "tsx src/index.ts --list-groups",
    "test": "tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:casa": "tsx src/index.ts --demo",
    "windows:instalar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/instalar-inicializacao.ps1",
    "windows:situacao": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/situacao.ps1",
    "windows:remover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remover-inicializacao.ps1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
