{
  "name": "financas-zap",
  "version": "1.0.0",
  "private": true,
  "description": "Ponte local que avisa no WhatsApp quando uma limpeza é registrada no app Casa.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test:message": "tsx src/index.ts --test-message",
    "list:groups": "tsx src/index.ts --list-groups",
    "test": "tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
